<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanum_lmpc_v2</name>
  <version>0.2.0</version>
  <description>Linear MPC v2 for the own mecanum robot: condensed LTV-MPC after Kuehne et al. (2005) on the exact Chaplygin dynamics of Zeidis &amp; Zimmermann (ZAMM 2019), wheel-torque inputs, RK4 discretisation.</description>
  <maintainer email="peter.varadi@egroup.hu">varad</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>tb3_sim_bringup</exec_depend>
  <exec_depend>mecanum_mpc_common</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- quadprog (QP solver) has no rosdep key: install it with pip into the user site, see README -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
