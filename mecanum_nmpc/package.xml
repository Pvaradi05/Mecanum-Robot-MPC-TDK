<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanum_nmpc</name>
  <version>0.1.0</version>
  <description>Nonlinear MPC for the own mecanum robot: Kuehne et al. (2005) NMPC on the exact Chaplygin dynamics of Zeidis &amp; Zimmermann (ZAMM 2019), wheel-torque inputs, RK4, multiple shooting, solved by acados (SQP, Gauss-Newton, HPIPM).</description>
  <maintainer email="peter.varadi@egroup.hu">varad</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>mecanum_mpc_common</exec_depend>
  <exec_depend>tb3_sim_bringup</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- acados (built from source in ~/acados) and its Python interface acados_template (with
       CasADi) have no rosdep keys: see the README -->

  <test_depend>python3-pytest</test_depend>
  <test_depend>mecanum_lmpc_v2</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
